def cmd_doctor(args: list[str]) -> int:
    """Cheap self-checks: stores, tmux, pi, service, snapshot, binding health."""
    import socket as _socket

    checks: list[tuple[str, str, str]] = []   # (status, name, detail)

    def add(status: str, name: str, detail: str) -> None:
        checks.append((status, name, detail))

    for root in L.SESSION_ROOTS:
        n = sum(1 for _ in __import__("glob").glob(
            os.path.join(root, "**", "*.jsonl"), recursive=True)) if os.path.isdir(root) else 0
        add("ok" if n else "warn", f"store {root.replace(os.path.expanduser('~'), '~')}",
            f"{n} transcripts" if n else "missing or empty")

    add("ok" if os.path.exists(L.AGENTBOARD) else "fail", "agentboard.py",
        L.AGENTBOARD.replace(os.path.expanduser("~"), "~"))

    ver = L.ab.sh(["tmux", "-V"]).strip()
    sessions = L.tmux_sessions()
    add("ok" if sessions else "fail", "tmux", f"{ver or 'not found'} · {len(sessions)} sessions")

    piver = L.ab.sh(["pi", "--version"]).strip().splitlines()
    help_txt = L.ab.sh(["pi", "--help"])
    add("ok" if "--session <path|id>" in help_txt else "warn", "pi",
        (piver[0] if piver else "not on PATH")
        + (" · --session supported" if "--session <path|id>" in help_txt else " · --session missing"))

    st = L.load_state()
    if st.get("sessions"):
        age = int(time.time()) - st.get("generated_epoch", 0)
        add("ok" if age < 3600 else "warn", "snapshot",
            f"{len(st['sessions'])} sessions · {L.human_age(age)} old · "
            f"{len(st.get('panes', []))} panes")
    else:
        add("warn", "snapshot", "no state.json — run `ledger snapshot`")

    active = L.ab.sh(["systemctl", "--user", "is-active", "ledger-serve.service"]).strip()
    add("ok" if active == "active" else "warn", "ledger-serve", active or "not installed")

    port, listening = 8900, False
    for cand in range(8900, 8920):
        s_ = _socket.socket()
        s_.settimeout(0.2)
        if s_.connect_ex(("127.0.0.1", cand)) == 0:
            listening, port = True, cand
            break
        s_.close()
    add("ok" if listening else "warn", "api", f"127.0.0.1:{port}" if listening else "not listening")

    launches = L.load_launches()
    add("ok" if launches else "dim", "launched.json", f"{len(launches)} pane(s) recorded")

    live = [r for r in st.get("sessions", []) if r.get("live")]
    guessed = [r for r in live if r.get("binding") in ("created-after", "succession")]
    unbound = [r for r in live if r.get("binding") == "none"]
    add("ok" if not guessed else "warn", "binding",
        f"{len(live)} live · {len(guessed)} inferred · {len(unbound)} unbound")

    dupes = sum(1 for r in st.get("sessions", []) if r.get("copies", 1) > 1)
    add("ok" if not dupes else "warn", "duplicates", f"{dupes} session id(s) in more than one file")

    bad = [r for r in st.get("sessions", []) if r.get("id") and not os.path.exists(r.get("path", ""))]
    add("ok" if not bad else "fail", "transcripts", f"{len(bad)} snapshot record(s) point at missing files")

    width = max(len(n) for _, n, _ in checks)
    for status, name, detail in checks:
        colr = {"ok": GRN, "warn": YEL, "fail": RED, "dim": DIM}[status]
        print(f"  {colr}{status:4s}{RST} {name:{width}s}  {DIM}{detail}{RST}")
    fails = sum(1 for s_, _, _ in checks if s_ == "fail")
    warns = sum(1 for s_, _, _ in checks if s_ == "warn")
    print(f"\n{len(checks) - fails - warns}/{len(checks)} ok"
          + (f" · {warns} warn" if warns else "")
          + (f" · {fails} fail" if fails else ""))
    return 1 if fails else 0


COMMANDS = {
    "table": cmd_table, "ls": cmd_table, "show": cmd_show, "open": cmd_open,
    "history": cmd_history, "snapshot": cmd_snapshot, "restore": cmd_restore,
    "serve": cmd_serve, "pin": cmd_pin, "doctor": cmd_doctor, "tui": cmd_tui,
}


def main(argv: list[str]) -> int:
    if hasattr(signal, "SIGPIPE"):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)   # `ledger table | head` exits quietly
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    fn = COMMANDS.get(argv[0])
    if not fn:
        sys.exit(f"ledger: unknown command {argv[0]!r}\n\n{__doc__}")
    return fn(argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
